local function rowToggle(page, text, default, callback)
    local c = createRow(page, text)
    local pbg = Instance.new("Frame", c)
    pbg.Size = UDim2.new(0, 36, 0, 18)
    pbg.Position = UDim2.new(1, -46, 0.5, -9)
    pbg.BackgroundColor3 = default and WHITE or Color3.fromRGB(20, 20, 20)
    Instance.new("UICorner", pbg).CornerRadius = UDim.new(0, 9)
    local ps = Instance.new("UIStroke", pbg); ps.Color = default and WHITE or BORDER
    local dot = Instance.new("Frame", pbg)
    dot.Size = UDim2.new(0, 14, 0, 14)
    dot.Position = default and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
    dot.BackgroundColor3 = default and BG or DIM
    Instance.new("UICorner", dot).CornerRadius = UDim.new(0, 7)

    local btn = Instance.new("TextButton", c)
    btn.Size = UDim2.new(1, 0, 1, 0); btn.BackgroundTransparency = 1; btn.Text = ""

    local isOn = default
    local function setVisual(val)
        isOn = val
        TweenService:Create(pbg, TweenInfo.new(0.2), {BackgroundColor3=isOn and WHITE or Color3.fromRGB(20, 20, 20)}):Play()
        TweenService:Create(ps,  TweenInfo.new(0.2), {Color=isOn and WHITE or BORDER}):Play()
        TweenService:Create(dot, TweenInfo.new(0.2), {
            Position = isOn and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7),
            BackgroundColor3 = isOn and BG or DIM
        }):Play()
    end
    btn.MouseButton1Click:Connect(function()
        isOn = not isOn; setVisual(isOn)
        if callback then pcall(callback, isOn) end
    end)
    return setVisual
end

local function rowInput(page, text, default, callback)
    local c = createRow(page, text)
    local box = Instance.new("TextBox", c)
    box.Size = UDim2.new(0, 60, 0, 24); box.Position = UDim2.new(1, -70, 0.5, -12)
    box.BackgroundColor3 = Color3.fromRGB(10, 10, 10); box.Text = tostring(default)
    box.TextColor3 = WHITE; box.Font = Enum.Font.GothamBold; box.TextSize = 11
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 4)
    Instance.new("UIStroke", box).Color = BORDER

    box.FocusLost:Connect(function()
        local n = tonumber(box.Text)
        if n then callback(n) else box.Text = tostring(default) end
    end)
    return box
end

local function rowActionBtn(page, text, onClick)
    local c = createRow(page, text)
    local lbl = c:FindFirstChildOfClass("TextLabel")
    local b = Instance.new("TextButton", c)
    b.Size = UDim2.new(1, 0, 1, 0); b.BackgroundTransparency = 1; b.Text = ""
    b.MouseButton1Click:Connect(function()
        TweenService:Create(c, TweenInfo.new(0.1), {BackgroundColor3=CARD_HOV}):Play()
        task.delay(0.1, function() TweenService:Create(c, TweenInfo.new(0.1), {BackgroundColor3=CARD_BG}):Play() end)
        if onClick then pcall(onClick) end
    end)
    return lbl
end

local function rowKBOnly(page, text, kbEntry, onKeyChange)
    local c = createRow(page, text)
    local b = Instance.new("TextButton", c)
    b.Size = UDim2.new(0, 80, 0, 24); b.Position = UDim2.new(1, -90, 0.5, -12)
    b.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    b.Text = kbEntry.kb and kbEntry.kb.Name or "+"
    b.TextColor3 = WHITE; b.Font = Enum.Font.GothamBold; b.TextSize = 10
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
    Instance.new("UIStroke", b).Color = BORDER

    local listening = false
    b.MouseButton1Click:Connect(function()
        if b.Text ~= "+" and not listening then
            b.Text = "+"
            kbEntry.kb = nil
            kbEntry.gp = nil
            if onKeyChange then onKeyChange(nil) end
        else
            listening = true; b.Text = "..."
        end
    end)
    UserInputService.InputBegan:Connect(function(inp, gpe)
        if listening and (inp.UserInputType == Enum.UserInputType.Keyboard or inp.UserInputType == Enum.UserInputType.Gamepad1) then
            listening = false
            if inp.KeyCode == Enum.KeyCode.Escape then b.Text = "+"; kbEntry.kb = nil; kbEntry.gp = nil; return end
            if inp.UserInputType == Enum.UserInputType.Keyboard then
                kbEntry.kb = inp.KeyCode; kbEntry.gp = nil; b.Text = inp.KeyCode.Name
            else
                kbEntry.gp = inp.KeyCode; kbEntry.kb = nil; b.Text = "GP:"..inp.KeyCode.Name
            end
            if onKeyChange then onKeyChange(inp.KeyCode) end
        end
    end)
    return b
end

local function rowToggleKB(page, text, kbEntry, default, onToggle, onKeyChange)
    local c = createRow(page, text)
    local b = Instance.new("TextButton", c)
    b.Size = UDim2.new(0, 44, 0, 24); b.Position = UDim2.new(1, -100, 0.5, -12)
    b.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    b.Text = kbEntry.kb and kbEntry.kb.Name or "+"
    b.TextColor3 = WHITE; b.Font = Enum.Font.GothamBold; b.TextSize = 10
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
    Instance.new("UIStroke", b).Color = BORDER

    local listening = false
    b.MouseButton1Click:Connect(function()
        if b.Text ~= "+" and not listening then
            b.Text = "+"; kbEntry.kb = nil; kbEntry.gp = nil; if onKeyChange then onKeyChange(nil) end
        else
            listening = true; b.Text = "..."
        end
    end)
    UserInputService.InputBegan:Connect(function(inp, gpe)
        if listening and (inp.UserInputType == Enum.UserInputType.Keyboard or inp.UserInputType == Enum.UserInputType.Gamepad1) then
            listening = false
            if inp.KeyCode == Enum.KeyCode.Escape then b.Text = "+"; kbEntry.kb = nil; kbEntry.gp = nil; return end
            if inp.UserInputType == Enum.UserInputType.Keyboard then
                kbEntry.kb = inp.KeyCode; kbEntry.gp = nil; b.Text = inp.KeyCode.Name
            else
                kbEntry.gp = inp.KeyCode; kbEntry.kb = nil; b.Text = "GP:"..inp.KeyCode.Name
            end
            if onKeyChange then onKeyChange(inp.KeyCode) end
        end
    end)

    local pbg = Instance.new("Frame", c)
    pbg.Size = UDim2.new(0, 36, 0, 18); pbg.Position = UDim2.new(1, -46, 0.5, -9)
    pbg.BackgroundColor3 = default and WHITE or Color3.fromRGB(20, 20, 20)
    Instance.new("UICorner", pbg).CornerRadius = UDim.new(0, 9)
    local ps = Instance.new("UIStroke", pbg); ps.Color = default and WHITE or BORDER
    local dot = Instance.new("Frame", pbg)
    dot.Size = UDim2.new(0, 14, 0, 14)
    dot.Position = default and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
    dot.BackgroundColor3 = default and BG or DIM
    Instance.new("UICorner", dot).CornerRadius = UDim.new(0, 7)

    local btn = Instance.new("TextButton", pbg)
    btn.Size = UDim2.new(1, 0, 1, 0); btn.BackgroundTransparency = 1; btn.Text = ""

    local isOn = default
    local function setVisual(val)
        isOn = val
        TweenService:Create(pbg, TweenInfo.new(0.2), {BackgroundColor3=isOn and WHITE or Color3.fromRGB(20, 20, 20)}):Play()
        TweenService:Create(ps,  TweenInfo.new(0.2), {Color=isOn and WHITE or BORDER}):Play()
        TweenService:Create(dot, TweenInfo.new(0.2), {
            Position = isOn and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7),
            BackgroundColor3 = isOn and BG or DIM
        }):Play()
    end
    btn.MouseButton1Click:Connect(function() isOn = not isOn; setVisual(isOn); if onToggle then pcall(onToggle, isOn) end end)
    return setVisual
end

-- ============================================================
-- ANTI BAT & GAME PLAY FUNCTIONS
-- ============================================================

local function startAntiBat()
    if Conns.antiBat then return end
    Conns.antiBat = RunService.Heartbeat:Connect(function()
        if not State.antiBatEnabled then return end
        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not root or not root.Parent then return end
        
        local originalVelocity = root.Velocity
        root.Velocity = Vector3.new(1000, originalVelocity.Y, 1000)
        
        RunService.RenderStepped:Wait()
        
        if root and root.Parent then
            root.Velocity = originalVelocity
        end
    end)
end

local function stopAntiBat()
    if Conns.antiBat then
        Conns.antiBat:Disconnect()
        Conns.antiBat = nil
    end
end

local function doDrop()
    if State.dropActive then return end
    local char = LP.Character; if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart"); if not root then return end
    State.dropActive = true
    local t0 = tick()
    local dc
    dc = RunService.Heartbeat:Connect(function()
        local r = char and char:FindFirstChild("HumanoidRootPart")
        if not r then dc:Disconnect(); State.dropActive = false; return end
        if tick() - t0 >= 0.2 then
            dc:Disconnect()
            local rp = RaycastParams.new()
            rp.FilterDescendantsInstances = {char}
            rp.FilterType = Enum.RaycastFilterType.Exclude
            local rr = workspace:Raycast(r.Position, Vector3.new(0, -2000, 0), rp)
            if rr then
                local hum2 = char:FindFirstChildOfClass("Humanoid")
                local off = (hum2 and hum2.HipHeight or 2) + (r.Size.Y / 2)
                r.CFrame = CFrame.new(r.Position.X, rr.Position.Y + off, r.Position.Z)
                r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
            State.dropActive = false
            return
        end
        r.AssemblyLinearVelocity = Vector3.new(r.AssemblyLinearVelocity.X, 150, r.AssemblyLinearVelocity.Z)
    end)
end

local function doTPDown()
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if root and hum then
        local rp = RaycastParams.new()
        rp.FilterDescendantsInstances = {char}
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.IgnoreWater = true
        
        local currentPos = root.Position
        local maxDist = 2000
        local hitPos = nil
        
        while maxDist > 0 do
            local res = workspace:Raycast(currentPos, Vector3.new(0, -maxDist, 0), rp)
            if res then
                if res.Instance.CanCollide then
                    hitPos = res.Position
                    break
                else
                    local filter = rp.FilterDescendantsInstances
                    table.insert(filter, res.Instance)
                    rp.FilterDescendantsInstances = filter
                    currentPos = res.Position - Vector3.new(0, 0.1, 0)
                    maxDist = maxDist - (root.Position.Y - currentPos.Y)
                end
            else
                break
            end
        end

        if hitPos then
            local newY = hitPos.Y + hum.HipHeight + (root.Size.Y / 2) + 0.05
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            root.CFrame = CFrame.new(root.Position.X, newY, root.Position.Z)
        end
    end
end

-- BAT AIMBOT
local lastBatSwing = 0
local function findBat()
    local char = LP.Character; if not char then return nil end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and (tool.Name:lower():find("bat") or tool.Name:lower():find("slap")) then return tool end
    end
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        for _, tool in ipairs(bp:GetChildren()) do
            if tool:IsA("Tool") and (tool.Name:lower():find("bat") or tool.Name:lower():find("slap")) then return tool end
        end
    end
    return nil
end

local function startBatAimbot()
    if Conns.aimbot then Conns.aimbot:Disconnect() end
    local hum0 = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if hum0 then hum0.AutoRotate = false end

    Conns.aimbot = RunService.RenderStepped:Connect(function()
        if not State.autoBatToggled then return end
        local char = LP.Character; if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart"); if not root then return end
        local hum = char:FindFirstChildOfClass("Humanoid"); if not hum then return end

        local bat = findBat()
        if bat and hum then
            if State.batMode == "Spam" then
                if bat.Parent ~= char then pcall(function() hum:EquipTool(bat) end) end
                if tick() - lastBatSwing >= 0.1 then
                    lastBatSwing = tick()
                    pcall(function() bat:Activate() end)
                end
            end
        end

        local closest, minDist = nil, math.huge
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LP and p.Character then
                local tr = p.Character:FindFirstChild("HumanoidRootPart")
                local th = p.Character:FindFirstChildOfClass("Humanoid")
                if tr and th and th.Health > 0 then
                    local d = (root.Position - tr.Position).Magnitude
                    if d < minDist then minDist = d; closest = tr end
                end
            end
        end

        if closest then
            local targetVel = closest.AssemblyLinearVelocity
            local predictPos = closest.Position + (targetVel * 0.1)
            predictPos = predictPos + closest.CFrame.LookVector * 0.3

            local direction = predictPos - root.Position
            local flatDir = Vector3.new(direction.X, 0, direction.Z)
            if flatDir.Magnitude > 0 then flatDir = flatDir.Unit else flatDir = Vector3.new(0,0,0) end
            
            local desiredHeight = closest.Position.Y + 3.7
            local yVel = (desiredHeight - root.Position.Y) * 19.5
            yVel = math.clamp(yVel, -70, 110)

            local desiredVel = Vector3.new(flatDir.X * 60, yVel, flatDir.Z * 60)
            root.AssemblyLinearVelocity = root.AssemblyLinearVelocity:Lerp(desiredVel, 0.8)

            local toPredict = predictPos - root.Position
            if toPredict.Magnitude > 0.1 then
                local goalCF = CFrame.lookAt(root.Position, predictPos)
                local curCF  = root.CFrame
                local diffCF = curCF:Inverse() * goalCF
                local rx, ry, rz = diffCF:ToEulerAnglesXYZ()
                rx = math.clamp(rx, -2.5, 2.5); ry = math.clamp(ry, -2.5, 2.5); rz = math.clamp(rz, -2.5, 2.5)
                root.AssemblyAngularVelocity = root.CFrame:VectorToWorldSpace(Vector3.new(rx * 45, ry * 45, rz * 45))
            end
        end
    end)
end

local function stopBatAimbot()
    if Conns.aimbot then Conns.aimbot:Disconnect(); Conns.aimbot = nil end
    local c = LP.Character
    local root = c and c:FindFirstChild("HumanoidRootPart")
    if root then root.AssemblyLinearVelocity = Vector3.zero; root.AssemblyAngularVelocity = Vector3.zero end
    local hum2 = c and c:FindFirstChildOfClass("Humanoid")
    if hum2 then hum2.AutoRotate = true end
end

-- ============================================================
-- ANTI RAGDOLL LOGIC
-- ============================================================
local function startAntiRagdoll()
    if Conns.antiRag then return end
    
    Conns.antiRag = RunService.Heartbeat:Connect(function()
        if not State.antiRagdollEnabled then return end
        
        local char = LP.Character
        if not char then return end
        
        local hum = char:FindFirstChildOfClass("Humanoid")
        
        if hum then
            local st = hum:GetState()
            if st == Enum.HumanoidStateType.Physics or 
               st == Enum.HumanoidStateType.Ragdoll or 
               st == Enum.HumanoidStateType.FallingDown then
                
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                
                workspace.CurrentCamera.CameraSubject = hum
                
                pcall(function() 
                    local pm = LP.PlayerScripts:FindFirstChild("PlayerModule")
                    if pm then 
                        require(pm:FindFirstChild("ControlModule")):Enable() 
                    end 
                end)
            end
        end
        
        for _, obj in ipairs(char:GetDescendants()) do 
            if obj:IsA("Motor6D") and not obj.Enabled then 
                obj.Enabled = true 
            end 
        end
    end)
end

local function stopAntiRagdoll()
    if Conns.antiRag then
        Conns.antiRag:Disconnect()
        Conns.antiRag = nil
    end
end

-- ============================================================
-- ESP LOGIC
-- ============================================================
local function createESP(plr)
    local char = plr.Character
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
    end

    if not char:FindFirstChild("NebulaESP_HL") then
        local hl = Instance.new("Highlight")
        hl.Name = "NebulaESP_HL"
        hl.FillColor = Color3.fromRGB(150, 50, 255)
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.Parent = char
    end

    local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    if head and not head:FindFirstChild("NebulaESP_BG") then
        local bg = Instance.new("BillboardGui")
        bg.Name = "NebulaESP_BG"
        bg.Size = UDim2.new(0, 150, 0, 50)
        bg.StudsOffset = Vector3.new(0, 3, 0)
        bg.AlwaysOnTop = true

        local txt = Instance.new("TextLabel")
        txt.Name = "InfoLabel"
        txt.Size = UDim2.new(1,0,1,0)
        txt.BackgroundTransparency = 1
        txt.Text = plr.Name
        txt.TextColor3 = Color3.fromRGB(255, 255, 255)
        txt.TextStrokeTransparency = 0.8
        txt.Font = Enum.Font.GothamBold
        txt.TextSize = 11
        txt.RichText = true
        txt.Parent = bg
        bg.Parent = head
    end
end

local function removeESP(plr)
    if plr.Character then
        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
        end
        local hl = plr.Character:FindFirstChild("NebulaESP_HL")
        if hl then hl:Destroy() end
        for _, v in ipairs(plr.Character:GetDescendants()) do
            if v.Name == "NebulaESP_BG" then v:Destroy() end
        end
    end
end

-- ============================================================
-- MASTER KILL SCRIPT FUNCTION
-- ============================================================
local function killHub()
    if isScriptKilled then return end
    isScriptKilled = true
    gui:Destroy()
    
    for k, v in pairs(Conns) do
        if type(v) == "table" then
            for _, c in ipairs(v) do pcall(function() c:Disconnect() end) end
        elseif v then pcall(function() v:Disconnect() end) end
    end
    
    State.isSpeedEnabled = false
    State.espEnabled = false
    State.noAnimationEnabled = false
    
    local char = LP.Character
    if char then
        local animate = char:FindFirstChild("Animate")
        if animate and animate:IsA("LocalScript") then
            animate.Disabled = false
        end
    end

    for _, p in ipairs(Players:GetPlayers()) do removeESP(p) end
    workspace.CurrentCamera.FieldOfView = 70
    Lighting.Brightness=1; Lighting.ClockTime=14; Lighting.OutdoorAmbient=Color3.fromRGB(128,128,128)
end

killBtn.MouseButton1Click:Connect(killHub)


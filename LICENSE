local function saveConfig()
    if isScriptKilled then return end
    local function ks(e) return {kb=e.kb and e.kb.Name or nil, gp=e.gp and e.gp.Name or nil} end
    local cfg = {
        speedNormal=State.speedNormal, speedCarry=State.speedCarry, 
        dropKey=ks(KB.Drop), tpDownKey=ks(KB.TPDown), autoBatKey=ks(KB.AutoBat), speedKey=ks(KB.Speed), guiHideKey=ks(KB.GuiHide), killHubKey=ks(KB.KillHub),
        antiBatKey=ks(KB.AntiBatToggle), instantResetKey=ks(KB.InstantReset),
        aimbotSpeed=State.aimbotSpeed,
        batMode=State.batMode, 
        grabRadius=State.grabRadius,
        uiScaleValue=State.uiScaleValue, mainPos=main and {xs=main.Position.X.Scale,xo=main.Position.X.Offset,ys=main.Position.Y.Scale,yo=main.Position.Y.Offset} or nil,
        
        isSpeedEnabled = State.isSpeedEnabled,
        antiBatEnabled = State.antiBatEnabled,
        noAnimationEnabled = State.noAnimationEnabled,
        autoBatToggled = State.autoBatToggled,
        infJumpEnabled = State.infJumpEnabled,
        antiRagdollEnabled = State.antiRagdollEnabled,
        autoGrabEnabled = State.autoGrabEnabled,
        espEnabled = State.espEnabled,
        stretchRezEnabled = State.stretchRezEnabled,
        darkModeEnabled = State.darkModeEnabled
    }
    pcall(function() writefile("NebulaConfig.json", HttpService:JSONEncode(cfg)) end)
end
task.spawn(function() while not isScriptKilled do task.wait(5); pcall(saveConfig) end end)

-- ============================================================
-- MASTER RENDER LOOP (KUSURSUZ BAR VE HIZ MOTORU)
-- ============================================================
local lastFillPct = 0
Conns.render = RunService.RenderStepped:Connect(function(dt)
    if isScriptKilled then return end

    pcall(function()
        if State.autoGrabEnabled then
            local active = StealState.active
            local justFinished = StealState.lastResultTime > 0 and (tick() - StealState.lastResultTime) < 1.2
            local success = justFinished and string.find(StealState.lastResult, "Stole") ~= nil

            local targetPct, targetColor, labelText

            if active then
                targetPct = math.clamp((tick() - StealState.startTime) / State.grabHoldMax, 0, 1)
                
                if StealState.phase == "holding" then
                    targetColor = Color3.fromRGB(160, 80, 255)
                    labelText = string.upper(StealState.label) .. "  ·  " .. string.format("%.1fs", tick() - StealState.startTime)
                elseif StealState.phase == "waitingRange" then
                    local pulseOffset = tick() * 4
                    targetPct = 0.5 + (math.sin(pulseOffset) * 0.05)
                    targetColor = Color3.fromRGB(255, 170, 0)
                    labelText = "YAKLAS (APPROACH)  ·  " .. string.upper(StealState.label)
                end
            elseif justFinished then
                targetPct = 1
                targetColor = success and Color3.fromRGB(120, 255, 140) or Color3.fromRGB(255, 70, 100)
                labelText = string.upper(StealState.lastResult)
            else
                targetPct = 0
                targetColor = Color3.fromRGB(140, 80, 255)
                labelText = "NEBULA HUB | READY"
            end

            lastFillPct = lastFillPct + (targetPct - lastFillPct) * math.min(dt * 14, 1)
            grabBarFill.Size = UDim2.new(lastFillPct, 0, 1, 0)
            grabBarFill.BackgroundColor3 = grabBarFill.BackgroundColor3:Lerp(targetColor, math.min(dt * 8, 1))
            grabBarDot.BackgroundColor3 = grabBarDot.BackgroundColor3:Lerp(targetColor, math.min(dt * 8, 1))

            grabBarLabel.Text = labelText
            if active then
                grabBarLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                grabBarLabel.TextTransparency = 0
            elseif justFinished then
                grabBarLabel.TextColor3 = success and Color3.fromRGB(200, 255, 200) or Color3.fromRGB(255, 200, 200)
                grabBarLabel.TextTransparency = 0
            else
                grabBarLabel.TextColor3 = Color3.fromRGB(160, 140, 150)
                grabBarLabel.TextTransparency = 0.25
            end

            grabBarStroke.Transparency = active and 0.1 or 0.45
            grabBarStroke.Color = active and targetColor or Color3.fromRGB(80, 60, 75)
        end
    end)
    
    pcall(function()
        if State.stretchRezEnabled then
            if workspace.CurrentCamera and workspace.CurrentCamera.FieldOfView ~= 120 then
                workspace.CurrentCamera.FieldOfView = 120
            end
        end
    end)
    
    pcall(function()
        local camera = workspace.CurrentCamera
        if camera then
            for _, v in ipairs(camera:GetChildren()) do
                if v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") then v.Enabled = false; v.Size = 0 end
            end
        end
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") then v.Enabled = false; v.Size = 0 end
        end
    end)

    local char = LP.Character
    if not char then return end
    
    pcall(function()
        local animate = char:FindFirstChild("Animate")
        if State.noAnimationEnabled then
            if animate and animate:IsA("LocalScript") then animate.Disabled = true end
            local humForAnim = char:FindFirstChildOfClass("Humanoid")
            if humForAnim then for _, track in ipairs(humForAnim:GetPlayingAnimationTracks()) do track:Stop() end end
        else
            if animate and animate:IsA("LocalScript") and animate.Disabled then animate.Disabled = false end
        end
    end)

    local hum = char:FindFirstChildOfClass("Humanoid")
    local root = char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then return end

    pcall(function()
        if State.infJumpEnabled and UserInputService:IsKeyDown(Enum.KeyCode.Space) then 
            root.Velocity = Vector3.new(root.Velocity.X, 50, root.Velocity.Z) 
        end
        
        local isTriggeringSteal = (StealState.phase == "waitingRange") 

        if State.isSpeedEnabled and not State.autoBatToggled and not State.dropActive and not isTriggeringSteal then
            if tick() - safeSpawnTime > 3 then 
                local walkSpeed = hum.WalkSpeed
                local targetSpeed = walkSpeed <= 20.4 and State.speedCarry or (walkSpeed <= 32 and State.speedCarry or State.speedNormal)
                local moveDir = hum.MoveDirection
                if moveDir.Magnitude > 0 then 
                    root.Velocity = Vector3.new(moveDir.X * targetSpeed, root.Velocity.Y, moveDir.Z * targetSpeed)
                end
            end
        end
    end)

    pcall(function()
        if State.espEnabled then
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character then 
                    createESP(p) 
                    local targetChar = p.Character
                    local head = targetChar:FindFirstChild("Head") or targetChar:FindFirstChild("HumanoidRootPart")
                    if head then
                        local bg = head:FindFirstChild("NebulaESP_BG")
                        if bg then
                            local txt = bg:FindFirstChild("InfoLabel")
                            if txt then
                                local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
                                local speed = targetHrp and targetHrp.Velocity.Magnitude or 0
                                txt.Text = string.format("<b>%s</b>\nSpeed: %.1f", p.Name, speed) 
                            end
                        end
                    end
                end
            end
        else
            for _, p in ipairs(Players:GetPlayers()) do removeESP(p) end
        end
    end)
end)

UserInputService.InputBegan:Connect(function(inp, gp)
    if gp and inp.UserInputType ~= Enum.UserInputType.Gamepad1 then return end
    if isScriptKilled then return end
    local kc = inp.KeyCode
    if kc == Enum.KeyCode.Unknown then return end
    pcall(function()
        if kbMatch(KB.Speed, kc) then
            State.isSpeedEnabled = not State.isSpeedEnabled
            if setSpeedVisual then setSpeedVisual(State.isSpeedEnabled) end
        elseif kbMatch(KB.AntiBatToggle, kc) then
            State.antiBatEnabled = not State.antiBatEnabled
            if setAntiBatVisual then setAntiBatVisual(State.antiBatEnabled) end
            if State.antiBatEnabled then pcall(startAntiBat) else stopAntiBat() end
        elseif kbMatch(KB.Drop, kc) then
            task.spawn(doDrop)
        elseif kbMatch(KB.TPDown, kc) then
            task.spawn(doTPDown)
        elseif kbMatch(KB.InstantReset, kc) then
            task.spawn(doInstantReset)
        elseif kbMatch(KB.AutoBat, kc) then
            State.autoBatToggled = not State.autoBatToggled
            if setAutoBatVisual then setAutoBatVisual(State.autoBatToggled) end
            if State.autoBatToggled then pcall(startBatAimbot) else stopBatAimbot() end
        elseif kbMatch(KB.GuiHide, kc) then
            State.guiVisible = not State.guiVisible
            main.Visible = State.guiVisible
        elseif kbMatch(KB.KillHub, kc) then
            killHub() 
        end
    end)
end)

-- BAŞLANGIÇTA DURUMLARI AKTİF ET
if State.autoGrabEnabled then pcall(startAutoSteal) end
if State.autoBatToggled then pcall(startBatAimbot) end
if State.antiRagdollEnabled then pcall(startAntiRagdoll) end
if State.antiBatEnabled then pcall(startAntiBat) end
if State.darkModeEnabled then pcall(function() Lighting.Brightness=0; Lighting.ClockTime=0; Lighting.OutdoorAmbient=Color3.fromRGB(0,0,0) end) end

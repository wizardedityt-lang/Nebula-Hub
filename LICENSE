-- ============================================================
-- AUTO SAVE & CONFIG LOOP
-- ============================================================
local function saveConfig()
    if isScriptKilled then return end
    local function ks(e) return {kb=e.kb and e.kb.Name or nil, gp=e.gp and e.gp.Name or nil} end
    local cfg = {
        speedNormal=State.speedNormal, speedCarry=State.speedCarry, isSpeedEnabled=State.isSpeedEnabled, noAnimationEnabled=State.noAnimationEnabled,
        dropKey=ks(KB.Drop), tpDownKey=ks(KB.TPDown), autoBatKey=ks(KB.AutoBat), speedKey=ks(KB.Speed), guiHideKey=ks(KB.GuiHide), killHubKey=ks(KB.KillHub),
        antiBatKey=ks(KB.AntiBatToggle), antiBatEnabled=State.antiBatEnabled,
        infJump=State.infJumpEnabled,
        autoBatToggled=State.autoBatToggled, batMode=State.batMode, espEnabled=State.espEnabled, antiRagdollEnabled=State.antiRagdollEnabled,
        uiScaleValue=State.uiScaleValue,
        mainPos=main and {xs=main.Position.X.Scale,xo=main.Position.X.Offset,ys=main.Position.Y.Scale,yo=main.Position.Y.Offset} or nil,
    }
    pcall(function() writefile("NebulaConfig.json", HttpService:JSONEncode(cfg)) end)
end

task.spawn(function()
    while not isScriptKilled do
        task.wait(5)
        pcall(saveConfig)
    end
end)

-- ============================================================
-- MASTER RENDER LOOP (WITH ANTI-BLUR)
-- ============================================================
Conns.render = RunService.RenderStepped:Connect(function()
    if isScriptKilled then return end
    
    pcall(function()
        local camera = workspace.CurrentCamera
        if camera then
            for _, v in ipairs(camera:GetChildren()) do
                if v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") then
                    v.Enabled = false
                    v.Size = 0
                end
            end
        end
        for _, v in ipairs(Lighting:GetChildren()) do
            if v:IsA("BlurEffect") or v:IsA("DepthOfFieldEffect") then
                v.Enabled = false
                v.Size = 0
            end
        end
    end)

    local char = LP.Character
    if not char then return end
    
    if State.noAnimationEnabled then
        local animate = char:FindFirstChild("Animate")
        if animate and animate:IsA("LocalScript") then
            animate.Disabled = true
        end
        local humForAnim = char:FindFirstChildOfClass("Humanoid")
        if humForAnim then
            for _, track in ipairs(humForAnim:GetPlayingAnimationTracks()) do
                track:Stop()
            end
        end
    else
        local animate = char:FindFirstChild("Animate")
        if animate and animate:IsA("LocalScript") and animate.Disabled then
            animate.Disabled = false
        end
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    
    if not hum or not hrp then return end

    if State.infJumpEnabled and UserInputService:IsKeyDown(Enum.KeyCode.Space) then
        hrp.Velocity = Vector3.new(hrp.Velocity.X, 50, hrp.Velocity.Z)
    end

    if State.isSpeedEnabled and not State.autoBatToggled then
        local walkSpeed = hum.WalkSpeed
        local targetSpeed

        if walkSpeed <= 20.4 then targetSpeed = State.speedCarry
        elseif walkSpeed > 20.4 and walkSpeed <= 32 then targetSpeed = State.speedCarry
        else targetSpeed = State.speedNormal end
        
        local moveDir = hum.MoveDirection
        if moveDir.Magnitude > 0 then 
            moveDir = moveDir.Unit
            local vel = hrp.Velocity
            hrp.Velocity = Vector3.new(moveDir.X * targetSpeed, vel.Y, moveDir.Z * targetSpeed)
        else
            local vel = hrp.Velocity
            hrp.Velocity = Vector3.new(0, vel.Y, 0)
        end
    end

    if State.espEnabled then
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character then 
                createESP(p) 
                local targetChar = p.Character
                local head = targetChar:FindFirstChild("Head") or targetChar:FindFirstChild("HumanoidRootPart") or targetChar:FindFirstChild("UpperTorso") or targetChar:FindFirstChild("Torso")
                if head then
                    local bg = head:FindFirstChild("NebulaESP_BG")
                    if bg then
                        local txt = bg:FindFirstChild("InfoLabel")
                        if txt then
                            local targetHrp = targetChar:FindFirstChild("HumanoidRootPart")
                            local speed = 0
                            if targetHrp then
                                speed = targetHrp.AssemblyLinearVelocity.Magnitude
                            end
                            
                            txt.Text = string.format("<b>%s</b>\nSpeed: %.1f", p.Name, speed)
                        end
                    end
                end
            end
        end
    else
        for _, p in ipairs(Players:GetPlayers()) do removeESP(p) end
    end
end)

UserInputService.InputBegan:Connect(function(inp, gp)
    if gp and inp.UserInputType ~= Enum.UserInputType.Gamepad1 then return end
    if isScriptKilled then return end
    local kc = inp.KeyCode
    if kc == Enum.KeyCode.Unknown then return end

    if kbMatch(KB.Speed, kc) then
        State.isSpeedEnabled = not State.isSpeedEnabled
        if setSpeedVisual then setSpeedVisual(State.isSpeedEnabled) end
    elseif kbMatch(KB.AntiBatToggle, kc) then
        State.antiBatEnabled = not State.antiBatEnabled
        if setAntiBatVisual then setAntiBatVisual(State.antiBatEnabled) end
        if State.antiBatEnabled then pcall(startAntiBat) else stopAntiBat() end
    elseif kbMatch(KB.Drop, kc) then
        task.spawn(doDrop)
    elseif kbMatch(KB.TPDown, kc) then
        task.spawn(doTPDown)
    elseif kbMatch(KB.AutoBat, kc) then
        State.autoBatToggled = not State.autoBatToggled
        if setAutoBatVisual then setAutoBatVisual(State.autoBatToggled) end
        if State.autoBatToggled then pcall(startBatAimbot) else stopBatAimbot() end
    elseif kbMatch(KB.GuiHide, kc) then
        State.guiVisible = not State.guiVisible
        main.Visible = State.guiVisible
    elseif kbMatch(KB.KillHub, kc) then
        killHub() 
    end
end)

if State.autoBatToggled then pcall(startBatAimbot) end
if State.antiRagdollEnabled then pcall(startAntiRagdoll) end
if State.antiBatEnabled then pcall(startAntiBat) end

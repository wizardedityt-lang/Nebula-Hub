local State = {
    isSpeedEnabled = false,
    speedNormal = 60,
    speedCarry = 30,
    noAnimationEnabled = false,

    autoBatToggled = false,
    batMode = "Manual",
    aimbotSpeed = 60, 
    antiBatEnabled = false, 
    infJumpEnabled = false,
    antiRagdollEnabled = false, 
    darkModeEnabled = false,
    stretchRezEnabled = false, 
    espEnabled = false,
    
    -- KAWAI AUTO GRAB AYARLARI
    autoGrabEnabled = false,
    grabRadius = 10,
    grabPrimeRange = 80,
    grabHoldMin = 1.3,
    grabHoldMax = 2.6,
    grabEntryDelay = 0.3,
    grabCooldown = 0.05,

    guiVisible = true,
    uiLocked = false,
    uiScaleValue = 100,

    dropActive = false,
}

local KB = {
    Drop          = {kb = Enum.KeyCode.X, gp = nil},
    TPDown        = {kb = Enum.KeyCode.F, gp = nil},
    AutoBat       = {kb = Enum.KeyCode.E, gp = nil},
    Speed         = {kb = Enum.KeyCode.Q, gp = nil},
    GuiHide       = {kb = Enum.KeyCode.LeftControl, gp = nil},
    AntiBatToggle = {kb = nil, gp = nil}, 
    InstantReset  = {kb = nil, gp = nil},
    KillHub       = {kb = nil, gp = nil}, 
}

local function kbMatch(entry, kc) return kc == entry.kb or (entry.gp and kc == entry.gp) end
local Conns = { aimbot = nil, stretch = nil, antiBat = nil, render = nil, antiRag = nil, autoGrab = nil }


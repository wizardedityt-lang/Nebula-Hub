    local ps = Instance.new("UIStroke", pbg); ps.Color = default and WHITE or BORDER
    local dot = Instance.new("Frame", pbg)
    dot.Size = UDim2.new(0, 14, 0, 14)
    dot.Position = default and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
    dot.BackgroundColor3 = default and BG or DIM
    Instance.new("UICorner", dot).CornerRadius = UDim.new(0, 7)

    local btn = Instance.new("TextButton", pbg)
    btn.Size = UDim2.new(1, 0, 1, 0); btn.BackgroundTransparency = 1; btn.Text = ""

    local isOn = default
    local function setVisual(val)
        isOn = val
        TweenService:Create(pbg, TweenInfo.new(0.2), {BackgroundColor3=isOn and WHITE or Color3.fromRGB(20, 20, 20)}):Play()
        TweenService:Create(ps,  TweenInfo.new(0.2), {Color=isOn and WHITE or BORDER}):Play()
        TweenService:Create(dot, TweenInfo.new(0.2), {
            Position = isOn and UDim2.new(1,-16,0.5,-7) or UDim2.new(0,2,0.5,-7),
            BackgroundColor3 = isOn and BG or DIM
        }):Play()
    end
    btn.MouseButton1Click:Connect(function() isOn = not isOn; setVisual(isOn); if onToggle then pcall(onToggle, isOn) end end)
    return setVisual
end

-- ============================================================
-- ESP SAFE FUNCTIONS
-- ============================================================
local function createESP(plr)
    pcall(function()
        if not plr or not plr.Character then return end
        local char = plr.Character
        local head = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
        if not head then return end
        
        if not char:FindFirstChild("NebulaESP_HL") then
            local hl = Instance.new("Highlight")
            hl.Name = "NebulaESP_HL"
            hl.FillColor = Color3.fromRGB(150, 50, 255)
            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
            hl.FillTransparency = 0.5
            hl.OutlineTransparency = 0
            hl.Parent = char
        end
        if not head:FindFirstChild("NebulaESP_BG") then
            local bg = Instance.new("BillboardGui")
            bg.Name = "NebulaESP_BG"
            bg.Size = UDim2.new(0, 150, 0, 50)
            bg.StudsOffset = Vector3.new(0, 3, 0)
            bg.AlwaysOnTop = true

            local txt = Instance.new("TextLabel")
            txt.Name = "InfoLabel"
            txt.Size = UDim2.new(1,0,1,0)
            txt.BackgroundTransparency = 1
            txt.Text = plr.Name 
            txt.TextColor3 = Color3.fromRGB(255, 255, 255)
            txt.TextStrokeTransparency = 0.8
            txt.Font = Enum.Font.GothamBold
            txt.TextSize = 11
            txt.RichText = true
            txt.Parent = bg
            bg.Parent = head
        end
    end)
end
local function removeESP(plr)
    pcall(function()
        if plr and plr.Character then
            local hl = plr.Character:FindFirstChild("NebulaESP_HL")
            if hl then hl:Destroy() end
            for _, v in ipairs(plr.Character:GetDescendants()) do
                if v.Name == "NebulaESP_BG" then v:Destroy() end
            end
        end
    end)
end

local function killHub()
    if isScriptKilled then return end
    isScriptKilled = true
    gui:Destroy()
    
    for k, v in pairs(Conns) do
        if type(v) == "table" then
            for _, c in ipairs(v) do pcall(function() c:Disconnect() end) end
        elseif v then pcall(function() v:Disconnect() end) end
    end
    
    State.isSpeedEnabled = false
    State.espEnabled = false
    State.noAnimationEnabled = false
    State.autoGrabEnabled = false
    
    local char = LP.Character
    if char then
        local animate = char:FindFirstChild("Animate")
        if animate and animate:IsA("LocalScript") then animate.Disabled = false end
    end

    for _, p in ipairs(Players:GetPlayers()) do removeESP(p) end
    workspace.CurrentCamera.FieldOfView = 70
    Lighting.Brightness=1; Lighting.ClockTime=14; Lighting.OutdoorAmbient=Color3.fromRGB(128,128,128)
end
killBtn.MouseButton1Click:Connect(killHub)


local function loadConfig()
    local isf = isfile or (syn and syn.isfile) or (getgenv and getgenv().isfile) or function() return false end
    local rdf = readfile or (syn and syn.readfile) or (getgenv and getgenv().readfile) or function() return nil end
    local hasFile=false; pcall(function() hasFile=isf("NebulaConfig.json") end)
    if not hasFile then return end
    local raw; pcall(function() raw=rdf("NebulaConfig.json") end)
    if not raw then return end
    local cfg; pcall(function() cfg=HttpService:JSONDecode(raw) end)
    if not cfg then return end

    if cfg.speedNormal then State.speedNormal = cfg.speedNormal end
    if cfg.speedCarry then State.speedCarry = cfg.speedCarry end
    if cfg.aimbotSpeed then State.aimbotSpeed = cfg.aimbotSpeed end
    if cfg.grabRadius then State.grabRadius = cfg.grabRadius end

    if cfg.isSpeedEnabled ~= nil then State.isSpeedEnabled = cfg.isSpeedEnabled end
    if cfg.antiBatEnabled ~= nil then State.antiBatEnabled = cfg.antiBatEnabled end
    if cfg.noAnimationEnabled ~= nil then State.noAnimationEnabled = cfg.noAnimationEnabled end
    if cfg.autoBatToggled ~= nil then State.autoBatToggled = cfg.autoBatToggled end
    if cfg.infJumpEnabled ~= nil then State.infJumpEnabled = cfg.infJumpEnabled end
    if cfg.antiRagdollEnabled ~= nil then State.antiRagdollEnabled = cfg.antiRagdollEnabled end
    if cfg.autoGrabEnabled ~= nil then State.autoGrabEnabled = cfg.autoGrabEnabled end
    if cfg.espEnabled ~= nil then State.espEnabled = cfg.espEnabled end
    if cfg.stretchRezEnabled ~= nil then State.stretchRezEnabled = cfg.stretchRezEnabled end
    if cfg.darkModeEnabled ~= nil then State.darkModeEnabled = cfg.darkModeEnabled end

    local function lk(e,d) 
        if not d then return end
        if d.kb and pcall(function() return Enum.KeyCode[d.kb] end) then e.kb=Enum.KeyCode[d.kb] else e.kb=nil end
        if d.gp and pcall(function() return Enum.KeyCode[d.gp] end) then e.gp=Enum.KeyCode[d.gp] else e.gp=nil end
    end
    lk(KB.Drop,cfg.dropKey); lk(KB.TPDown,cfg.tpDownKey); lk(KB.AutoBat,cfg.autoBatKey); 
    lk(KB.Speed,cfg.speedKey); lk(KB.GuiHide,cfg.guiHideKey); lk(KB.KillHub,cfg.killHubKey);
    lk(KB.AntiBatToggle, cfg.antiBatKey); lk(KB.InstantReset, cfg.instantResetKey)

    if cfg.batMode then State.batMode = cfg.batMode end
    if cfg.uiScaleValue then State.uiScaleValue = cfg.uiScaleValue end
    
    return cfg.mainPos
end

local savedMainPos = loadConfig()

